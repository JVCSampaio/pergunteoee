# Copie para .env se quiser. O arquivo .env não entra no git.
# Valores que já estiverem no ambiente não são substituídos.

# mock: a interface e os testes funcionam sem modelo e sem chave.
# openai: qualquer endpoint compatível com a API de chat da OpenAI.
LLM_PROVIDER=mock

# Ollama:      http://127.0.0.1:11434/v1
# LM Studio:   http://127.0.0.1:1234/v1
# llama.cpp:   http://127.0.0.1:8080/v1
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=nome-do-modelo-carregado
OPENAI_TIMEOUT=120

PERGUNTEOEE_DB=data/pergunteoee.duckdb
